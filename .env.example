# Supabase — create a project at https://supabase.com, then copy these from
# Project Settings -> API. The anon key is safe to expose in the browser;
# RLS is what protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: set to "true" to run against local mock data with no Supabase
# connection (useful for UI work before the backend is provisioned).
VITE_USE_MOCK=false

# Facturación electrónica SUNAT:
#   (vacío)  -> stub (demo, sin envío real)
#   beta     -> emite vía la Edge Function `sunat-emitir` al ambiente de pruebas
# Requiere desplegar la función y cargar los secrets (ver
# supabase/functions/sunat-emitir/README.md).
VITE_SUNAT_MODE=

# Pasarela de la PLATAFORMA para cobrar la suscripción SaaS a los tenants
# (llave pública Culqi de tu cuenta; la secreta va como secret PLATFORM_CULQI_SECRET
# en la Edge Function saas-cobrar).
VITE_PLATFORM_CARD_PK=

# Notificaciones push (Web Push / VAPID). Genera el par una sola vez con
# `npx web-push generate-vapid-keys` (o generateVapidKeys() de
# supabase/functions/_shared/push/webpush.ts). La pública NO es secreta y va aquí;
# la privada va como secret VAPID_PRIVATE_KEY en la Edge Function push-enviar,
# junto con VAPID_PUBLIC_KEY y VAPID_SUBJECT (mailto:soporte@tudominio.pe).
VITE_VAPID_PUBLIC_KEY=
